<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: #fdfdff -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#fdfdff" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Blue wash: rgba(163,198,236,0.8) → transparent, bottom-left (30%, 80%) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="180%"
                android:startColor="#CCA3C6EC"
                android:endColor="#00A3C6EC"
                android:centerX="0.30"
                android:centerY="0.90" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Purple-pink wash: rgba(225,205,235,0.7) → transparent, bottom-right (85%, 90%) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="160%"
                android:startColor="#B2E1CDEB"
                android:endColor="#00E1CDEB"
                android:centerX="0.85"
                android:centerY="0.90" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Center soft blend: rgba(210,225,245,0.2) → transparent, center (50%, 50%) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%"
                android:startColor="#33D2E1F5"
                android:endColor="#00D2E1F5"
                android:centerX="0.50"
                android:centerY="0.50" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- White fade from top: 25% white blending into gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
